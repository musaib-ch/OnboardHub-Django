# Copy to .env and fill in. Loaded by your shell / process manager — Django
# reads these from the environment (see onboardhub/settings.py).

# Flip to "production" to enable secure-cookie + hardened settings.
APP_ENV=production

# Long random string. Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-value

# Public hostname(s) Cloudflare serves the app on (comma-separated).
ALLOWED_HOSTS=onboard.example.com

# Must include scheme. Required for POST forms / CSRF behind the tunnel.
CSRF_TRUSTED_ORIGINS=https://onboard.example.com

# Optional
APP_TIMEZONE=Asia/Karachi
SESSION_TIMEOUT_MINUTES=30
# Set >0 (e.g. 31536000) only once the domain is permanently HTTPS.
SECURE_HSTS_SECONDS=0
